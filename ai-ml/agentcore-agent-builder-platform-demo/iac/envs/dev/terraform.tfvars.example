# Required — copy to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars (it contains secrets)

aws_region        = "us-west-2"
project           = "aiops-v2"
env               = "dev"
vpc_cidr          = "10.1.0.0/16"
cloudfront_secret = "CHANGE_ME_TO_A_RANDOM_SECRET"

# Optional — leave empty to use CloudFront default domain
# If set, requires ACM wildcard cert in both deployment region and us-east-1
domain_name       = ""
