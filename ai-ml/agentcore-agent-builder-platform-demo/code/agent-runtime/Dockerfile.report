# code/agent/Dockerfile.report
# Per review B-M4: use build arg for ECR base reference
ARG BASE_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
FROM ${BASE_IMAGE}

# The base image (Dockerfile L35) switches to the non-root `appuser`, which
# cannot write to the site-packages dir. Switch back to root for the report-only
# dependency install, then drop back to appuser so the runtime stays non-root.
USER root

COPY report_tools/ ./report_tools/

RUN pip install --no-cache-dir jinja2 \
    && chown -R appuser:appgroup /app

USER appuser
