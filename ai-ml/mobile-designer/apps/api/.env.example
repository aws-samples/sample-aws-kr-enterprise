# Application
MDESIGNER_ENVIRONMENT=development
MDESIGNER_DEBUG=true

# AWS General
MDESIGNER_AWS_REGION=ap-northeast-2
MDESIGNER_AWS_BEDROCK_REGION=us-west-2

# DynamoDB (local dev)
MDESIGNER_DYNAMODB_ENDPOINT_URL=http://localhost:8000

# S3 (local dev with LocalStack)
MDESIGNER_S3_ENDPOINT_URL=http://localhost:4566
MDESIGNER_S3_BUCKET_NAME=mdesigner-files
MDESIGNER_S3_PRESIGNED_URL_EXPIRY=3600

# JWT
MDESIGNER_JWT_SECRET_NAME=dev-secret-key-change-in-production
MDESIGNER_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
MDESIGNER_JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
MDESIGNER_JWT_ALGORITHM=HS256

# CORS
MDESIGNER_CORS_ORIGINS=["http://localhost:5173"]

# SES
MDESIGNER_SES_SENDER_EMAIL=noreply@example.com
MDESIGNER_SES_REGION=ap-northeast-2

# Bedrock AgentCore
MDESIGNER_BEDROCK_AGENT_ID=
MDESIGNER_BEDROCK_AGENT_ALIAS_ID=

# File Upload
MDESIGNER_MAX_FILE_SIZE_MB=20
